[Unit]
Description=PandoraBOX Body Runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/PandoraBOX
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arduino/PandoraBOX/start_body.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
